{
  "name": "AffiliateApplication",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Applicant's full name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Applicant's email address"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Application status"
    },
    "rewardful_link": {
      "type": "string",
      "description": "The Rewardful affiliate link to send to approved affiliates"
    }
  },
  "required": [
    "name",
    "email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {}
  }
}
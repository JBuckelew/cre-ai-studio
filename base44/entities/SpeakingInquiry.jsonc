{
  "name": "SpeakingInquiry",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Inquirer's full name"
    },
    "organization": {
      "type": "string",
      "description": "Organization or company"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Inquirer's email"
    },
    "event_date": {
      "type": "string",
      "description": "Proposed event date or TBD"
    },
    "format": {
      "type": "string",
      "description": "Requested speaking format"
    },
    "message": {
      "type": "string",
      "description": "Details about the event"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "contacted",
        "booked"
      ],
      "default": "pending",
      "description": "Inquiry status"
    }
  },
  "required": [
    "name",
    "email",
    "message"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {}
  }
}
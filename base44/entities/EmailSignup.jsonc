{
  "name": "EmailSignup",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "description": "The user's email address"
    },
    "source": {
      "type": "string",
      "default": "hero_signup",
      "description": "Where the signup came from"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {}
  }
}
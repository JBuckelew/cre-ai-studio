{
  "name": "ContactSignup",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "First name of the user"
    },
    "last_name": {
      "type": "string",
      "description": "Last name of the user"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address"
    },
    "company": {
      "type": "string",
      "description": "Company name"
    },
    "source": {
      "type": "string",
      "default": "hero_signup",
      "description": "Where the signup came from"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "email",
    "company"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {}
  }
}
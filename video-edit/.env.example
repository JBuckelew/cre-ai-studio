# Optional. Leave blank to skip AI music (you can still drop a track in references/music.mp3).
ELEVENLABS_API_KEY=

# Whisper settings. small.en is fast on CPU; medium.en or large-v3 is more accurate but slower.
WHISPER_MODEL=small.en
# cpu works everywhere. Use cuda only if you have an NVIDIA GPU with CUDA 12 + cuDNN 9 installed.
WHISPER_DEVICE=cpu
